                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    ct.CustomerID,
    c.CustomerName,
    c.Email,
    c.Phone,
    c.Gender,
    c.City,
    c.Country,
    c.CustomerType,
    c.CreatedDate,
    c.ModifiedDate,
    CT.SYS_CHANGE_OPERATION AS Operation 
FROM 
    CHANGETABLE(CHANGES Customers, ?) AS CT
LEFT JOIN 
    Customers AS c ON CT.CustomerID = c.CustomerID</property>
