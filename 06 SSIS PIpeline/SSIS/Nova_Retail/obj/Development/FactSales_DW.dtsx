                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    OD.OrderDetailID,
    OD.OrderID,
    OD.Quantity,
    OD.UnitPrice,
    OD.Discount,
    O.OrderDate,
    O.OrderStatus,
    O.SalesChannel,
    P.UnitCost,
    -- Fetch Surrogate Keys
    ISNULL(C.CustomerKey, -1) AS CustomerKey,
    ISNULL(P.ProductKey, -1) AS ProductKey,
    ISNULL(S.StoreKey, -1) AS StoreKey,
    ISNULL(E.EmployeeKey, -1) AS EmployeeKey,
    ISNULL(D.DateKey, -1) AS DateKey

FROM Nova_Retail_Staging_DB.Stg.OrderDetails OD
INNER JOIN Nova_Retail_Staging_DB.Stg.Orders O 
    ON OD.OrderID = O.OrderID

-- 1. SCD Type 2 Customer Lookup
LEFT JOIN Nova_Retail_DW.Dim.Customer C 
    ON O.CustomerID = C.CustomerID
    AND O.OrderDate &gt;= C.EffectiveStartDate 
    AND (C.EffectiveEndDate IS NULL OR O.OrderDate &lt; C.EffectiveEndDate)

-- 2. Standard Product Lookup (No SCD Type 2 date range needed)
LEFT JOIN Nova_Retail_DW.Dim.Product P 
    ON OD.ProductID = P.ProductID

-- 3. SCD Type 2 Store Lookup
LEFT JOIN Nova_Retail_DW.Dim.Store S 
    ON O.StoreID = S.StoreID
    AND O.OrderDate &gt;= S.EffectiveStartDate 
    AND (S.EffectiveEndDate IS NULL OR O.OrderDate &lt; S.EffectiveEndDate)

-- 4. SCD Type 2 Employee Lookup
LEFT JOIN Nova_Retail_DW.Dim.Employee E 
    ON O.EmployeeID = E.EmployeeID
    AND O.OrderDate &gt;= E.EffectiveStartDate 
    AND (E.EffectiveEndDate IS NULL OR O.OrderDate &lt; E.EffectiveEndDate)

-- 5. Date Dimension Lookup
LEFT JOIN Nova_Retail_DW.Dim.Date D 
    ON CAST(O.OrderDate AS DATE) = D.FullDate</property>
                <property
